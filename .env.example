# URL gốc của Strapi CMS (không có dấu / cuối).
NEXT_PUBLIC_STRAPI_URL=https://cms.chinasourcing.co

# Domain public của site — dùng cho canonical URL, og:url, sitemap, robots và
# log của webhook revalidate. Đọc lúc BUILD (biến NEXT_PUBLIC_*), nên đổi giá
# trị này thì phải build lại.
NEXT_PUBLIC_SITE_URL=https://chinasourcing.co

# Cổng nội bộ để `src/proxy.ts` đọc bảng định tuyến (/api/route-slugs) mà không
# vòng ra CDN. Bỏ trống thì proxy tự gọi vào origin công khai của chính nó —
# vẫn chạy, chỉ chậm hơn một nhịp và phụ thuộc cache biên.
# INTERNAL_BASE_URL=http://127.0.0.1:3000

# Bí mật dùng chung với webhook Strapi. Tạo bằng: openssl rand -base64 32
REVALIDATE_SECRET=

# =1 để BỎ cache khi soạn nội dung (mỗi request đọc thẳng Strapi).
# STRAPI_CACHE_DISABLED=1

# Đường dẫn (tương đối, ghép NEXT_PUBLIC_STRAPI_URL) tới PDF hướng dẫn cho nút
# Download ở /resources. Upload file mới vào Media Library rồi lấy path ở đây.
NEXT_PUBLIC_SOURCING_GUIDE_PATH=

# HubSpot — lưới đỡ cho form đăng ký nhận tin ở footer khi CMS
# (`global.footer.newsletterForm`) còn trống. Site gốc dùng portal 46681098,
# form e30221f0-7060-4147-9b7b-4dc9593f7828, region na1.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_NEWSLETTER_FORM_ID=
NEXT_PUBLIC_HUBSPOT_REGION=na1
